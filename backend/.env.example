# Connexion PostgreSQL SAVAA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/savaa
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=savaa

# Port du serveur API REST
PORT=4000
JWT_SECRET=savaa-ci-secret-key-2026-prod
SAVAA_STAFF_CODE=SAVAA-EQUIPE

# Passerelle SMS OTP Côte d'Ivoire (Orange SMS API / Infobip) — laisser vide en mode simulation (code 1234)
SMS_LIVE=false
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SAVAA

# Passerelle Mobile Money (CinetPay / Wave Business / Hub2) — laisser vide en mode simulation
MOMO_API_URL=
MOMO_API_KEY=
MOMO_SITE_ID=

# Service d'itinéraire routier OSRM (optionnel)
OSRM_API_URL=

