{
  "name": "savaa-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:mobile": "vite --config apps/mobile/vite.config.ts",
    "dev:api": "node backend/server.mjs",
    "db:migrate": "node backend/db/migrate.mjs",
    "build": "tsc -b && vite build && vite build --config apps/web/vite.config.ts && vite build --config apps/mobile/vite.config.ts",
    "build:web": "tsc -b && vite build --config apps/web/vite.config.ts",
    "build:mobile": "tsc -b && vite build --config apps/mobile/vite.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test": "vitest run",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "npm run build:mobile && cap sync android && cap open android",
    "mobile:ios": "npm run build:mobile && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@eslint/js": "^9.25.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
